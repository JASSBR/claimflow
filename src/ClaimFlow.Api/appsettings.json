{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "InitializeOnStartup": false,
    "SeedDemoData": false
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50
  },
  "RateLimiting": {
    "PermitPerMinute": 120
  }
}
